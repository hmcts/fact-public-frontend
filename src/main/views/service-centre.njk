{% extends "template.njk" %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "govuk/components/accordion/macro.njk" import govukAccordion %}

{% from "components/addresses.njk" import addresses as renderAddresses %}
{% from "components/useful-information.njk" import usefulInformation as renderUsefulInformation %}
{% from "components/cases-heard.njk" import casesHeard as renderCasesHeard %}
{% from "components/contact-details.njk" import contactDetails as renderContactDetails %}

{% set contactDetailsHtml %}
  {{ renderContactDetails(
    serviceCentre.serviceCentreContactDetails,
    contactDetails,
    htmlLang,
    "serviceCentreContactDescription"
  ) }}
{% endset %}


{% if serviceCentre.serviceCentreAreasOfLaw and serviceCentre.serviceCentreAreasOfLaw.length %}
  {% set casesHeardHtml %}
    {{ renderCasesHeard(serviceCentre.serviceCentreAreasOfLaw, casesHeard, htmlLang) }}
  {% endset %}
{% endif %}

{% set warningNotice = serviceCentre.warningNotice %}
{% if htmlLang == "cy" and serviceCentre.warningNoticeCy and serviceCentre.warningNoticeCy | trim %}
  {% set warningNotice = serviceCentre.warningNoticeCy %}
{% endif %}

{% block pageTitle %}
  {{ serviceCentre.name }} - {{ pageTitleSuffix }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l govuk-!-margin-bottom-2">{{ serviceCentre.name }}</h1>
      <p class="govuk-body-s">{{ pageLastReviewed }} {{ serviceCentre.lastUpdatedAt }}</p>

      {% if warningNotice %}
        {{ govukWarningText({
          html: warningNotice | nl2br,
          iconFallbackText: warningFallbackText
        }) }}
      {% endif %}

      <hr class="govuk-section-break govuk-section-break--m">

      {% if serviceCentre.serviceCentreAddresses and serviceCentre.serviceCentreAddresses | length > 0 %}
        {{ renderAddresses(serviceCentre.serviceCentreAddresses, addresses) }}
      {% else %}
        <h2 class="govuk-heading-m">{{ addresses.heading }}</h2>
        <p class="govuk-body"> {{ addresses.noAddressFound}}</p>
      {% endif %}
      <hr class="govuk-section-break govuk-section-break--m">

      {{ renderUsefulInformation(usefulInformation, false) }}
      <hr class="govuk-section-break govuk-section-break--m">

      {{ govukAccordion({
        id: "service-centre-details-accordion",
        hideAllSectionsText: accordion.hideAllSections,
        hideSectionText: accordion.hideSection,
        hideSectionAriaLabelText: accordion.hideSectionAriaLabel,
        showSectionText: accordion.showSection,
        showSectionAriaLabelText: accordion.showSectionAriaLabel,
        showAllSectionsText: accordion.showAllSections,
        items: [
          {
            heading: { text: accordion.contactDetailsHeading },
            expanded: false,
            content: { html: contactDetailsHtml }
          },
          {
            heading: { text: accordion.casesHeardHeading },
            expanded: false,
            content: { html: casesHeardHtml }
          } if casesHeardHtml else null
        ]
      }) }}
    </div>
  </div>
{% endblock %}
