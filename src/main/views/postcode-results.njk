{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% extends "template.njk" %}

{% block pageTitle %}
  {{ title }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-l">
        {{ question }}
      </h1>
      <div class="govuk-grid-column-two-thirds">
        <div class="govuk-grid-row">
          {% if isDivorceOrCivil %}
            <div>
              <p class="govuk-body-m">
                {% if serviceArea === 'divorce' %}
                  {{ divorceHint }}
                {% else %}
                  {{ civilHint }}
                {% endif %}
                {{ secondHint | replace('{postcode}', postcode) }}
                <br>
                {{ thirdHint }}
              </p>
            </div>
            <div class="search-result">
              <h2 class="govuk-heading-m">
                <a class="govuk-link"
                   href="/courts/{{ results.courts[0].courtSlug }}">{{ results.courts[0].courtName }}</a>
              </h2>
            </div>
          {% else %}
            <div>
              {% if postcodeOnlySearch %}
                <p class="govuk-body-m">
                  {{ postcodeSearchResultsHint
                  | replace('{postcode}', postcode)
                  | replace('{total}', results.courts.length) }}
                </p>
              {% else %}
                {% set resultsHint = singleResultsHint if results.courts.length === 1 else multipleResultsHint %}
                <p class="govuk-body-m">
                  {{ resultsHint
                  | replace('{postcode}', postcode)
                  | replace('{total}', results.courts.length)
                  | replace('{serviceArea}', serviceArea) }}
                </p>
              {% endif %}

            </div>
            <div id="search-results">
              {% for court in results.courts %}
                <div class="govuk-grid-row">
                  <div class="govuk-grid-column-three-quarters">
                    <h2 class="govuk-heading-m">
                      <a class="govuk-link"
                         href="/courts/{{ court.courtSlug }}">{{ court.courtName }}</a>
                    </h2>
                  </div>
                  <div class="govuk-grid-column-one-quarter distance">
                    <p class="govuk-body-m">
                      {{ court.distance.toFixed(1) }} {{ unit }}
                    </p>
                  </div>
                </div>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
      {% if results.onlineText and results.onlineUrl %}
        <div class="govuk-grid-column-one-third side-content">
          <div id="areas-of-law">
            <h3 class="govuk-heading-m">
              {{ applyOnlineHeading }}
            </h3>
            <p class="govuk-body-m">
              <a class="govuk-link" href="{{ results.onlineUrl }}"> {{ results.onlineText }} </a>
            </p>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
{% endblock %}
