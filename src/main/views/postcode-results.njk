{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% extends "template.njk" %}

{% block pageTitle %}
  {{ title }}
{% endblock %}

{% block content %}
  {% set searchResults = results.courts %}
  {% if not postcodeOnlySearch and results.locations %}
    {% set searchResults = results.locations %}
  {% endif %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <h1 class="govuk-heading-l">
        {{ question }}
      </h1>
      <div class="govuk-grid-column-two-thirds">
        <div class="govuk-grid-row">
          {% if isDivorceOrCivil %}
            <div>
              <p class="govuk-body-m">
                {% if serviceArea === 'divorce' %}
                  {{ divorceHint }}
                {% else %}
                  {{ civilHint }}
                {% endif %}
                {{ secondHint | replace('{postcode}', postcode) }}
                <br>
                {{ thirdHint }}
              </p>
            </div>
            <div class="search-result">
              {% set resultName = searchResults[0].name if searchResults[0].name else searchResults[0].courtName %}
              {% set resultSlug = searchResults[0].slug if searchResults[0].slug else searchResults[0].courtSlug %}
              <h2 class="govuk-heading-m">
                <a class="govuk-link"
                   href="{% if searchResults[0].type === 'SERVICE_CENTRE' %}/service-centres/{{ resultSlug }}{% else %}/courts/{{ resultSlug }}{% endif %}">{{ resultName }}</a>
              </h2>
            </div>
          {% else %}
            <div>
              {% if postcodeOnlySearch %}
                <p class="govuk-body-m">
                  {{ postcodeSearchResultsHint
                  | replace('{postcode}', postcode)
                  | replace('{total}', searchResults.length) }}
                </p>
              {% else %}
                {% set resultsHint = singleResultsHint if searchResults.length === 1 else multipleResultsHint %}
                <p class="govuk-body-m">
                  {{ resultsHint
                  | replace('{postcode}', postcode)
                  | replace('{total}', searchResults.length)
                  | replace('{serviceArea}', serviceArea) }}
                </p>
              {% endif %}

            </div>
            <div id="search-results">
              {% for result in searchResults %}
                {% set resultName = result.name if result.name else result.courtName %}
                {% set resultSlug = result.slug if result.slug else result.courtSlug %}
                <div class="govuk-grid-row">
                  <div class="govuk-grid-column-three-quarters">
                    <h2 class="govuk-heading-m">
                      <a class="govuk-link"
                         href="{% if result.type === 'SERVICE_CENTRE' %}/service-centres/{{ resultSlug }}{% else %}/courts/{{ resultSlug }}{% endif %}">{{ resultName }}</a>
                    </h2>
                  </div>
                  <div class="govuk-grid-column-one-quarter distance">
                    <p class="govuk-body-m">
                      {{ result.distance.toFixed(1) }} {{ unit }}
                    </p>
                  </div>
                </div>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
      {% if onlineText and onlineUrl %}
        <div class="govuk-grid-column-one-third side-content">
          <div id="areas-of-law">
            <h3 class="govuk-heading-m">
              {{ applyOnlineHeading }}
            </h3>
            <p class="govuk-body-m">
              <a class="govuk-link" href="{{ onlineUrl }}"> {{ onlineText }} </a>
            </p>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
{% endblock %}
