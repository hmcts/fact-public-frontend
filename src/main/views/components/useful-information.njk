{% macro usefulInformation(text) %}
  <section id="useful-information">
    <h2 class="govuk-heading-m">{{ text.mainHeading }}</h2>

    <h3 class="govuk-heading-s govuk-!-margin-bottom-2">{{ text.comingToCourt }}</h3>
    <p class="govuk-body">
      <a href="{{ text.comingToCourtUrl }}"
         class="govuk-link govuk-link--no-visited-state" rel="noreferrer noopener"
         target="_blank">{{ text.comingToCourtUrlText }}</a>, {{ text.comingToCourtBody }}
    </p>

    <h3 class="govuk-heading-s govuk-!-margin-bottom-2">{{ text.hearingsAtThisCourt }}</h3>
    <p class="govuk-body">
      <a href="{{ text.hearingsAtThisCourtUrl }}"
         class="govuk-link govuk-link--no-visited-state" rel="noreferrer noopener"
         target="_blank">{{ text.hearingsAtThisCourtUrlText }}</a>, {{ text.hearingsAtThisCourtBody }}
    </p>

    <h3 class="govuk-heading-s govuk-!-margin-bottom-2">{{ text.scammers }}</h3>
    <p class="govuk-body">
      {{ text.scammersBodyPrefix }}
      <a href="{{ text.scammersUrl }}"
         class="govuk-link govuk-link--no-visited-state"
         rel="noreferrer noopener" target="_blank">{{ text.scammersUrlText }}</a>.
    </p>
  </section>
{% endmacro %}
