{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% macro contactDetails(contactDetails, text, language, descriptionProperty="courtContactDescription") %}
  <section id="contact-details">
    {% set isWelsh = language == "cy" %}
    {% set enquiries = [] %}
    {% set others = [] %}
    {% for contact in contactDetails %}
      {% set contactDescription = contact[descriptionProperty] %}
      {% if contactDescription %}
        {% set contactNameLower = contactDescription.name | lower %}
        {% if contactNameLower == "enquiries" %}
          {% set enquiries = enquiries.concat([contact]) %}
        {% else %}
          {% set others = others.concat([contact]) %}
        {% endif %}
      {% endif %}
    {% endfor %}

    {% if isWelsh %}
      {% set others = others | sort(attribute=descriptionProperty + ".nameCy") %}
    {% else %}
      {% set others = others | sort(attribute=descriptionProperty + ".name") %}
    {% endif %}

    {% set contacts = enquiries.concat(others) %}

    {% for contact in contacts %}
      {% set contactDescription = contact[descriptionProperty] %}
      {% set caption = contactDescription.nameCy if isWelsh else contactDescription.name %}
      {% set explanation = contact.explanationCy if isWelsh else contact.explanation %}

      {% if contact.phoneNumber and contact.phoneNumber | trim %}
        {% set phoneNumberHtml %}
          <span class="phone-text">{{ contact.phoneNumber }}</span>
          <a href="tel:{{ contact.phoneNumber }}" class="govuk-link govuk-link--no-visited-state phone-link">
            {{ contact.phoneNumber }}
          </a>
        {% endset %}
      {% endif %}

      {% if contact.email and contact.email | trim %}
        {% set emailHtml %}
          <a href="mailto:{{ contact.email }}" class="govuk-link govuk-link--no-visited-state">
            <span class="govuk-!-text-break-word">{{ contact.email }}</span>
          </a>
        {% endset %}
      {% endif %}

      <div>
        <h1 class="govuk-heading-s govuk-!-margin-bottom-0">{{ caption }}</h1>
        {% if explanation and explanation | trim %}
          <p class="govuk-hint govuk-!-margin-top-0 govuk-!-margin-bottom-0">{{ explanation }}</p>
        {% endif %}
      </div>

      {{ govukSummaryList({
        rows: [ {
            key: { text: text.telephone }, value: { html: phoneNumberHtml }
          } if phoneNumberHtml else undefined, {
            key: { text: text.email }, value: { html: emailHtml }
          } if emailHtml else undefined
        ]
      }) }}

    {% endfor %}
  </section>
{% endmacro %}
