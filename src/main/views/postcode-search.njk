{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% extends "template.njk" %}

{% block pageTitle %}
  {% if error %}
    {{ errorTitle }}
  {% endif %}
  {{ title }}
{% endblock %}

{% block content %}
{% if error %}
  {{ govukErrorSummary({
    titleText: errorText.title,
    errorList: [{
      text: errorText[errorType],
      href: '#postcode'
    }]
  }) }}
{% endif %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
      <h1 class="govuk-fieldset__heading">
        {{ question }}
      </h1>
    </legend>

    <div id="header-hint" class="govuk-hint">
      {% if serviceAreaIsChildcare %}
        {{ hints.childcare }}
      {% else %}
        {% if noServiceSearch %}
          {{ hints.noService }}
        {% else %}
          {{ hints.default | replace("{serviceArea}", serviceAreaLocalised | lower ) }}
        {% endif %}
      {% endif %}
    </div>

    <form method="POST" action="{{ actionUrl }}">
      {{ govukInput({
        label: {
          text: text,
          classes: "govuk-label",
          isPageHeading: true
        },
        classes: "govuk-input govuk-input--width-10",
        id: "postcode",
        name: "postcode",
        value: postcode,
        errorMessage: { text: errorText[errorType] } if error,
        autocomplete: "postal-code"
      }) }}
      {{ govukButton({
        text: button,
        classes: "govuk-!-margin-top-2 govuk-!-margin-bottom-8 continue"
      }) }}
    </form>

    {% if hasNoResults %}
      <div class="no-search-results" id="no-search-results">
        <p class="govuk-body-m govuk-!-font-weight-bold">{{ noResults.p1 }}</p>
        <p class="govuk-body">{{ noResults.p2 }}</p>
        <ul class="govuk-list govuk-list--bullet">
          {% for item, text in noResults.list %}
          <li>{{ text }}</li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}

  </div>
</div>

{% endblock %}
