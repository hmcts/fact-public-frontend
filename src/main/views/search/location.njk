{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

{% extends "template.njk" %}

{% set hasSearched = hasSearched or false %}
{% set searchQuery = search or '' %}
{% set resultList = results or [] %}
{% set errorByType = {
  'blank': errorBlank,
  'tooShort': errorTooShort,
  'errorBlank': errorBlank,
  'errorTooShort': errorTooShort
} %}
{% set pageError = error or errorByType[errorType] %}

{% block pageTitle %}
  {% if pageError %}
    {{ errorTitle }}
  {% endif %}
  {{ resultsTitle if hasSearched else title }}
{% endblock %}

{% block content %}
  {% if pageError %}
    {{ govukErrorSummary({
      titleText: pageError.title,
      errorList: [
        {
          text: pageError.text,
          href: "#search"
        }
      ]
    }) }}
  {% endif %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if courtHistoryFlag and courtHistory and courtHistory.slug %}
        {% set renamedLocationHtml %}
          <p class="govuk-notification-banner__heading">
            {{ courtHistoryText }}
            <a class="govuk-notification-banner__link" href="/courts/{{ courtHistory.slug }}">{{ courtHistory.historicalName }}</a>
            {{ to }}
            <a class="govuk-notification-banner__link" href="/courts/{{ courtHistory.slug }}">{{ courtHistory.name }}</a>.
          </p>
        {% endset %}

        {{ govukNotificationBanner({
          html: renamedLocationHtml
        }) }}
      {% endif %}

      <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
        <h1 class="govuk-fieldset__heading">{{ question }}</h1>
      </legend>

      <div id="know-location-hint" class="govuk-hint">
        {{ hint }}
      </div>

      <form method="post" action="/search-by-name" novalidate>
        {{ govukInput({
          label: {
            text: text,
            classes: "govuk-label--m"
          },
          hint: {
            text: textExample
          },
          classes: "govuk-!-width-three-quarters",
          id: "search",
          name: "search",
          value: searchQuery,
          errorMessage: { text: pageError.text } if pageError
        }) }}

        {{ govukButton({
          text: button,
          classes: "govuk-!-margin-top-2 govuk-!-margin-bottom-8 continue"
        }) }}
      </form>

      {% if hasSearched and resultList.length > 0 %}
        {% set foundSingleResultText = foundResult | replace('{search}', searchQuery) %}
        {% set foundMultipleResultsText = foundResults | replace('{total}', resultList.length) | replace('{search}', searchQuery) %}
        <p role="status" class="govuk-body">{{ foundSingleResultText if resultList.length === 1 else foundMultipleResultsText }}</p>
        <p class="govuk-body">{{ mostRelevant }}</p>
        <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible">
        <div class="search-results" id="search-results">
          {% for item in resultList %}
            {% set resultPath = '/service-centres/' if item.serviceCentre or item.locationType === 'SERVICE_CENTRE' else '/courts/' %}
            <h2 class="govuk-heading-m">
              <a class="govuk-link" href="{{ resultPath }}{{ item.slug }}">{{ item.name }}</a>
            </h2>
          {% endfor %}
        </div>
      {% elif hasSearched and noResults %}
        <div class="no-search-results" id="no-search-results">
          <p role="status" class="govuk-body-m govuk-!-font-weight-bold">{{ noResults.p1 }}</p>
          <p class="govuk-body">{{ noResults.p2 }}</p>
          <ul class="govuk-list govuk-list--bullet">
            {% for key, itemText in noResults.list %}
              <li>{{ itemText }}</li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
    </div>
  </div>
{% endblock %}
