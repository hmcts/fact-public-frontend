{
  "name": "fact-public-frontend",
  "description": "Public Frontend for the Find a Court or Tribunal service",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.21.1"
  },
  "scripts": {
    "start": "NODE_ENV=production ts-node --transpile-only -r tsconfig-paths/register src/main/server.ts",
    "start:dev": "node ./scripts/dev-watcher.js",
    "lint": "stylelint **/*.scss -v -q && eslint . --ext .js,.ts && prettier --check .",
    "lint:fix": "prettier --write . .github && eslint --fix .",
    "build": "yarn webpack --config webpack.config.js",
    "build:prod": "NODE_ENV=production yarn webpack --mode production --config webpack.config.js",
    "test": "npx if-env CI=true && exit 0 || yarn test:unit",
    "test:unit": "jest",
    "test:coverage": "jest --coverage",
    "test:routes": "jest -c jest.routes.config.js",
    "test:smoke": "NODE_TLS_REJECT_UNAUTHORIZED=0 jest -c jest.smoke.config.js",
    "cichecks": "yarn install && yarn build && yarn lint && yarn test && yarn test:routes",
    "prepare": "husky install",
    "test:functional": "playwright test",
    "test:functional:chrome": "playwright test src/test/functional --project=chromium",
    "test:functional:firefox": "playwright test src/test/functional --project=firefox",
    "test:functional:webkit": "playwright test src/test/functional --project=webkit",
    "test:accessibility": "playwright test src/test/a11y",
    "test:a11y": "echo 'a11y tests run as part of test:functional' && exit 0",
    "test:functional:headed": "playwright test --headed",
    "test:functional:ui": "playwright test --ui",
    "test:functional:debug": "playwright test --debug"
  },
  "dependencies": {
    "@azure/identity": "4.13.1",
    "@grpc/grpc-js": "^1.14.4",
    "@hmcts/cookie-manager": "1.1.0",
    "@hmcts/info-provider": "1.4.0",
    "@hmcts/nodejs-healthcheck": "1.8.6",
    "@hmcts/nodejs-logging": "4.0.4",
    "@hmcts/properties-volume": "1.4.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/lodash": "4.17.24",
    "@types/nunjucks": "3.2.6",
    "@types/require-directory": "2.1.7",
    "applicationinsights": "3.15.0",
    "async-mutex": "0.5.0",
    "awilix": "13.0.3",
    "awilix-express": "11.0.1",
    "axios": "1.17.0",
    "config": "4.4.1",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "express-rate-limit": "8.5.2",
    "express-session": "1.19.0",
    "glob": "13.0.6",
    "govuk-frontend": "5.14.0",
    "helmet": "8.2.0",
    "i18next": "26.3.1",
    "i18next-http-middleware": "3.9.7",
    "lodash": "4.18.1",
    "luxon": "3.7.2",
    "nunjucks": "3.2.4",
    "stylelint": "17.13.0",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@babel/core": "7.29.7",
    "@babel/plugin-proposal-decorators": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@eslint/compat": "2.1.0",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.60.0",
    "@types/babel__preset-env": "7.10.0",
    "@types/chai": "5.2.3",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.19.19",
    "@types/sinon": "21.0.1",
    "@types/supertest": "7.2.0",
    "@typescript-eslint/eslint-plugin": "8.61.0",
    "@typescript-eslint/parser": "8.61.0",
    "babel-jest": "30.4.1",
    "babel-loader": "10.1.1",
    "chai": "6.2.2",
    "chokidar": "5.0.0",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.4",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.15.2",
    "eslint-plugin-playwright": "2.10.4",
    "globals": "17.6.0",
    "html-webpack-plugin": "5.6.7",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "jest-html-reporter": "4.4.0",
    "lint-staged": "17.0.7",
    "mini-css-extract-plugin": "2.10.2",
    "playwright": "1.60.0",
    "playwright-core": "1.60.0",
    "prettier": "3.8.3",
    "sass": "1.100.0",
    "sass-loader": "16.0.8",
    "sinon": "22.0.0",
    "style-loader": "4.0.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.11",
    "ts-loader": "9.6.0",
    "webpack": "5.107.2",
    "webpack-cli": "7.0.3",
    "webpack-dev-middleware": "8.0.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown",
    "**/*.{js,ts}": "eslint --fix"
  },
  "resolutions": {
    "protobufjs": "7.6.3",
    "uuid": "14.0.0"
  },
  "packageManager": "yarn@4.16.0"
}
