{
  "name": "fact-public-frontend",
  "description": "Public Frontend for the Find a Court or Tribunal service",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "start": "NODE_ENV=production ts-node --transpile-only -r tsconfig-paths/register src/main/server.ts",
    "start:dev": "node ./scripts/dev-watcher.js",
    "lint": "stylelint **/*.scss -v -q && eslint . --ext .js,.ts && prettier --check .",
    "lint:fix": "prettier --write . .github && eslint --fix .",
    "build": "yarn webpack --config webpack.config.js",
    "build:prod": "NODE_ENV=production yarn webpack --mode production --config webpack.config.js",
    "test": "npx if-env CI=true && exit 0 || yarn test:unit",
    "test:unit": "jest",
    "test:coverage": "jest --coverage",
    "test:routes": "jest -c jest.routes.config.js",
    "test:smoke": "yarn playwright test --grep '@smoke'",
    "cichecks": "yarn install && yarn build && yarn lint && yarn test && yarn test:routes",
    "prepare": "husky install",
    "test:functional": "NODE_OPTIONS=--no-deprecation yarn playwright test --grep-invert='@smoke'",
    "test:functional:chrome": "yarn playwright test --project=chrome",
    "test:functional:edge": "yarn playwright test --project=edge",
    "test:functional:firefox": "yarn playwright test --project=firefox",
    "test:functional:webkit": "yarn playwright test --project=webkit",
    "test:performance": "yarn playwright test --grep='@performance'",
    "test:a11y": "echo 'a11y tests run as part of test:functional' && exit 0",
    "test:functional:headed": "playwright test --headed",
    "test:functional:ui": "playwright test --ui",
    "test:functional:debug": "playwright test --debug",
    "playwright:report": "yarn playwright show-report test-results/odhin-report --host 0.0.0.0"
  },
  "dependencies": {
    "@azure/identity": "4.14.0",
    "@grpc/grpc-js": "^1.14.6",
    "@hmcts/cookie-manager": "1.1.0",
    "@hmcts/info-provider": "1.4.0",
    "@hmcts/nodejs-healthcheck": "1.8.6",
    "@hmcts/nodejs-logging": "4.0.4",
    "@hmcts/properties-volume": "1.4.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/lodash": "4.17.26",
    "@types/nunjucks": "3.2.6",
    "@types/require-directory": "2.1.7",
    "applicationinsights": "3.17.0",
    "async-mutex": "0.5.0",
    "awilix": "13.0.5",
    "awilix-express": "11.0.1",
    "axios": "1.20.0",
    "config": "5.0.1",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "express-session": "1.19.0",
    "glob": "13.0.6",
    "govuk-frontend": "6.6.0",
    "helmet": "8.3.0",
    "i18next": "26.5.3",
    "i18next-http-middleware": "3.9.9",
    "lodash": "4.18.1",
    "luxon": "3.7.2",
    "nunjucks": "3.2.4",
    "require-directory": "2.1.1",
    "stylelint": "17.16.0",
    "ts-node": "10.9.2",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "8.0.7",
    "@babel/plugin-proposal-decorators": "8.0.2",
    "@babel/preset-env": "8.0.7",
    "@babel/preset-typescript": "8.0.7",
    "@eslint/compat": "2.1.1",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@hmcts/playwright-common": "^1.1.5",
    "@playwright/test": "1.64.1",
    "@types/babel__preset-env": "7.10.0",
    "@types/chai": "5.2.3",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/sinon": "22.0.0",
    "@types/supertest": "7.2.1",
    "@typescript-eslint/eslint-plugin": "8.72.0",
    "@typescript-eslint/parser": "8.72.0",
    "babel-jest": "30.5.2",
    "babel-loader": "10.1.1",
    "chai": "6.3.0",
    "chokidar": "5.0.0",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.5",
    "dotenv": "^17.4.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.17.0",
    "eslint-plugin-playwright": "2.12.1",
    "get-port": "^7.2.0",
    "globals": "17.13.0",
    "html-webpack-plugin": "5.6.8",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-html-reporter": "4.4.2",
    "lighthouse": "13.5.0",
    "lint-staged": "17.6.0",
    "mini-css-extract-plugin": "2.10.2",
    "odhin-reports-playwright": "1.3.0",
    "playwright": "1.64.1",
    "playwright-core": "1.64.1",
    "playwright-lighthouse": "^4.0.0",
    "prettier": "3.9.10",
    "sass": "1.105.2",
    "sass-loader": "17.0.1",
    "sinon": "22.1.0",
    "style-loader": "4.0.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-loader": "9.6.2",
    "webpack": "5.112.0",
    "webpack-cli": "7.2.3",
    "webpack-dev-middleware": "8.5.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown",
    "**/*.{js,ts}": "eslint --fix"
  },
  "resolutions": {
    "@opentelemetry/core": "2.12.0",
    "source-map-js": "1.2.2",
    "proxy-addr": "2.0.8",
    "uuid": "14.0.3",
    "moment": "2.31.0",
    "ip-address": "10.7.4",
    "brace-expansion": "5.0.12",
    "follow-redirects": "1.16.1"
  },
  "packageManager": "yarn@4.17.1"
}
